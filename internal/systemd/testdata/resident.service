[Unit]
Description=keep service web
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/opt/keep/bin/keep fork web
Restart=always
RestartSec=10
StandardOutput=append:/home/m/.local/state/keep/logs/web.out.log
StandardError=append:/home/m/.local/state/keep/logs/web.err.log

[Install]
WantedBy=default.target

[X-Keep]
Managed=true
Service=web
Version=1.2.3
Path=/opt/keep/bin/keep
