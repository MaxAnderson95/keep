<plist version="1.0">
<dict>
	<key>Label</key>
	<string>keep.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/keep/bin/keep</string>
		<string>fork</string>
		<string>backup</string>
	</array>
	<key>StandardOutPath</key>
